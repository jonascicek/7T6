# Example env
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Prisma database URL (SQLite for now)
DATABASE_URL=file:./prisma/dev.db
# Required admin login credentials (email + bcrypt hash)
ADMIN_EMAIL=admin@example.com
# If this file is used by docker compose, escape $ as $$ in bcrypt hashes
# Example: $$2b$$12$$replace.with.bcrypt.hash
ADMIN_PASSWORD_HASH=$2b$12$replace.with.bcrypt.hash
# JWT settings
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
# Optional override in milliseconds (default: 7200000)
# JWT_MAX_AGE_MS=7200000
# Optional Cloudinary URL: set to the full cloudinary://... url
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
