# Optional absolute API URL for environments where frontend and backend are on different origins.
# Leave empty to use same-origin requests (recommended with reverse proxy).
VITE_API_BASE_URL=

# Optional hidden admin route segment used by frontend routing.
# Example login URL: /intern-7t6-entry-a94k1x and panel URL: /intern-7t6-entry-a94k1x/panel
# Keep this value private and share only internally.
VITE_ADMIN_ROUTE_SEGMENT=intern-7t6-entry-a94k1x
